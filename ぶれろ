local function updateFlightLogic()
    if flyMoveConnection then
        flyMoveConnection:Disconnect()
        flyMoveConnection = nil
    end
    if not flyConfig.Enabled then return end
    flyMoveConnection = RunService.Heartbeat:Connect(function()
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then return end
        local hasTool = char:FindFirstChild(flyConfig.SelectedItem)
        if not hasTool then
            local tb = player.Backpack and player.Backpack:FindFirstChild(flyConfig.SelectedItem)
            if tb then hum:EquipTool(tb) end
        end
        if hasTool or char:FindFirstChild(flyConfig.SelectedItem) then
            -- Autopilot mode (Tp next Base)
            if flyConfig.AutoPilot and flyConfig.TargetPos then
                local direction = (flyConfig.TargetPos - hrp.Position).Unit
                local distance = (flyConfig.TargetPos - hrp.Position).Magnitude
                if distance > 5 then
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        direction.X * flyConfig.Speed,
                        hrp.AssemblyLinearVelocity.Y,
                        direction.Z * flyConfig.Speed
                    )
                else
                    -- Arrived at target
                    flyConfig.AutoPilot = false
                    flyConfig.TargetPos = nil
                    hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
                end
            -- Manual mode
            else
                local md = hum.MoveDirection
                if md.Magnitude > 0 then
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        md.X * flyConfig.Speed,
                        hrp.AssemblyLinearVelocity.Y,
                        md.Z * flyConfig.Speed
                    )
                else
                    hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
                end
            end
        end
    end)
end

