    local function updateKeybindDisplay()
        if waitingForKey then
            keybindLbl.Text = "( )"
            keybindLbl.TextColor3 = COL_TEXT
        elseif currentKeybind then
            keybindLbl.Text = currentKeybind
            keybindLbl.TextColor3 = COL_TEXT_DIM
        else
            keybindLbl.Text = ""
        end
    end

    local function setKeybind(key)
        currentKeybind = key
        keybinds[labelText] = key
        updateKeybindDisplay()
    end

    local function clearKeybind()
        currentKeybind = nil
        keybinds[labelText] = nil
        updateKeybindDisplay()
    end

    keybindLbl.MouseButton1Click:Connect(function()
        local now = os.clock()
        if now - lastClickTime < 0.3 then
            clearKeybind()
            waitingForKey = false
            updateKeybindDisplay()
            lastClickTime = 0
        else
            waitingForKey = true
            updateKeybindDisplay()
            lastClickTime = now
        end
    end)

    keybindLbl.MouseButton2Click:Connect(function()
        local now = os.clock()
        if now - lastClickTime < 0.3 then
            clearKeybind()
            waitingForKey = false
            updateKeybindDisplay()
            lastClickTime = 0
        else
            waitingForKey = true
            updateKeybindDisplay()
            lastClickTime = now
        end
    end)

    ActionBindRegistry[labelText] = {
        getKeybind = function() return currentKeybind end,
        setKeybind = setKeybind,
        isWaiting = function() return waitingForKey end,
        waitForKey = function(key)
            if waitingForKey then
                setKeybind(key)
                waitingForKey = false
                updateKeybindDisplay()
                return true
            end
            return false
        end,
        execute = onClickFn,
    }

    if defaultKeybind then
        keybinds[labelText] = defaultKeybind
    end

    return setKeybind
end

