    -- OPTIMIZATION: slot visibility radius (only slots within this radius are displayed)
    local VISIBILITY_RADIUS = 60 -- studs

    local function drawSlot(plot, root, e, color, slotNum)
        local yOffset = (slotNum <= 10) and 0.2 or 0
        local cf = CFrame.new(e[1], e[2] + yOffset, e[3]) * CFrame.Angles(0, math.rad(e[4]), 0)
        local worldCF = root.CFrame * cf
        local anchor = makeInvisibleAnchor(worldCF)

        local fTrans = (slotNum <= 10) and 0.72 or FILL_T
        local iTrans = (slotNum <= 10) and 0.58 or INNER_T

        box(anchor, CFrame.new(), OUTER, color, fTrans, true, slotNum)
        box(anchor, CFrame.new(0, INNER_UP, 0), INNER_SZ, color, iTrans, true, slotNum)
        edges(anchor, CFrame.new(), OUTER, color)
        solid(worldCF)
        labelFor(plot, anchor, slotNum, color)

        return worldCF.Position -- return world position for distance checking
    end

    -- OPTIMIZATION: check if slot is within visibility radius
    local function isSlotNearPlayer(worldPos)
        local char = LP.Character
        if not char then return false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        return (hrp.Position - worldPos).Magnitude <= VISIBILITY_RADIUS
    end

    -- OPTIMIZATION: cache of created slots for fast updates
    local createdSlots = {} -- {[plot] = {[slotNum] = worldPos}}

    local function build()
        if not alive then return end
        clear()
        table.clear(createdSlots)

        for _, plot in ipairs(Plots:GetChildren()) do
            local root = plot:FindFirstChild("MainRoot")
            if root then
                createdSlots[plot] = {}
                for i = 1, #TEMPLATE do
                    local yOffset = (i <= 10) and 0.2 or 0
                    local cf = CFrame.new(TEMPLATE[i][1], TEMPLATE[i][2] + yOffset, TEMPLATE[i][3]) * CFrame.Angles(0, math.rad(TEMPLATE[i][4]), 0)
                    local worldCF = root.CFrame * cf
                    local worldPos = worldCF.Position

                    -- OPTIMIZATION: create only slots within visibility radius
                    if isSlotNearPlayer(worldPos) then
                        drawSlot(plot, root, TEMPLATE[i], colorFor(i), i)
                    end

                    -- Save position for future checks
                    createdSlots[plot][i] = worldPos
                end
            end
        end
    end

    -- OPTIMIZATION: update slot visibility (create new ones, remove distant ones)
    local function updateVisibleSlots()
        if not alive then return end

        local char = LP.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local playerPos = hrp.Position

        -- Collect slots that should be visible
        local shouldBeVisible = {}
        for plot, slots in pairs(createdSlots) do
            local root = plot:FindFirstChild("MainRoot")
            if root then
                for slotNum, worldPos in pairs(slots) do
                    local dist = (playerPos - worldPos).Magnitude
                    if dist <= VISIBILITY_RADIUS then
                        if not shouldBeVisible[plot] then shouldBeVisible[plot] = {} end
                        shouldBeVisible[plot][slotNum] = true
                    end
                end
            end
        end

        -- Compare with current state and rebuild if needed
        local needsRebuild = false

        -- Check: are there slots that should appear
        for plot, slots in pairs(shouldBeVisible) do
            for slotNum in pairs(slots) do
                -- Check if this slot is already created
                local exists = false
                for _, item in ipairs(fills) do
                    if item.index == slotNum then
                        exists = true
                        break
                    end
                end
                if not exists then
                    needsRebuild = true
                    break
                end
            end
            if needsRebuild then break end
        end

        -- Check: are there created slots that should disappear
        if not needsRebuild then
            for _, item in ipairs(fills) do
                local plot = nil
                for p, slots in pairs(createdSlots) do
                    if slots[item.index] then
                        plot = p
                        break
                    end
                end
                if plot then
                    local slots = shouldBeVisible[plot]
                    if not slots or not slots[item.index] then
                        needsRebuild = true
                        break
                    end
                end
            end
        end

        if needsRebuild then
            build()
        end
    end

    build()

    local function findCurrentPlot()
        local char = LP.Character
        if not char then return nil end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local pos = hrp.Position
        local best, bestDist = nil, math.huge
        for _, plot in ipairs(Plots:GetChildren()) do
            local root = plot:FindFirstChild("MainRoot")
            if root then
                local d = (root.Position - pos).Magnitude
                if d < bestDist then
                    best = plot
                    bestDist = d
                end
            end
        end
        if bestDist > 100 then return nil end
        return best
    end

    local function updateVisibility()
        local newPlot = findCurrentPlot()
        if newPlot == currentPlot then return end
        currentPlot = newPlot
        for plot, list in pairs(labelsByPlot) do
            local show = (plot == currentPlot)
            for _, bg in ipairs(list) do
                if bg and bg.Parent then bg.Enabled = show end
            end
        end
    end

    local pending = false
    local function rebuild()
        if pending or not alive then return end
        pending = true
        task.delay(0.4, function()
            pending = false
            build()
            updateVisibility()
        end)
    end

    local function watch(plot)
        if not plot:FindFirstChild("MainRoot") then
            local root = plot:WaitForChild("MainRoot", 30)
            if root and alive then rebuild() end
        end
    end
    for _, plot in ipairs(Plots:GetChildren()) do task.spawn(watch, plot) end
    conns[#conns + 1] = Plots.ChildAdded:Connect(function(plot)
        task.spawn(watch, plot)
        rebuild()
    end)

    conns[#conns + 1] = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        Camera = workspace.CurrentCamera
        if alive then rebuild() end
    end)

    do
        -- OPTIMIZATION: separate timers for different tasks
        local visAcc = 0
        local animAcc = 0
        local platformAcc = 0
        local lastPlotPos = nil -- cache of current plot position

        -- OPTIMIZATION: check platform every 100ms (instead of every frame)
        -- and only for anchors of current plot
        local function checkPlatformOptimized(dt)
            if not currentPlot then
                wasOnPlatform = false
                standTimer = 0
                return
            end

            local char = LP.Character
            if not char then
                wasOnPlatform = false
                standTimer = 0
                return
            end

            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then
                wasOnPlatform = false
                standTimer = 0
                return
            end

            local state = hum:GetState()
            local isFreefall = (state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.FallingDown)
            if isFreefall then
                wasOnPlatform = false
                standTimer = 0
                return
            end

            local vel = hrp.AssemblyLinearVelocity
            if math.abs(vel.Y) > 6 then
                wasOnPlatform = false
                standTimer = 0
                return
            end

            local pos = hrp.Position
            local isOnTop = false

            -- OPTIMIZATION: check only anchors of current plot (if exists)
            local anchorsToCheck = labelsByPlot[currentPlot] or labelAnchors
            for _, anchor in ipairs(anchorsToCheck) do
                if anchor and anchor.Parent then
                    local rel = anchor.CFrame:PointToObjectSpace(pos)
                    if math.abs(rel.X) <= 3.0 and math.abs(rel.Z) <= 3.0 and rel.Y >= 0.1 and rel.Y <= 3.0 then
                        isOnTop = true
                        break
                    end
                end
            end

            if isOnTop then
                standTimer = standTimer + dt
                if standTimer >= STAND_THRESHOLD then
                    if not wasOnPlatform then
                        wasOnPlatform = true
                        equipBat()
                    end
                end
            else
                standTimer = 0
                wasOnPlatform = false
            end
        end

        -- OPTIMIZATION: visibility update with position caching
        local function updateVisibilityOptimized()
            local char = LP.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local pos = hrp.Position

            -- OPTIMIZATION: if player is near last known plot, don't recalculate
            if lastPlotPos and currentPlot then
                local dist = (pos - lastPlotPos).Magnitude
                if dist < 50 then return end -- within the same plot
            end

            local newPlot = findCurrentPlot()
            if newPlot == currentPlot then
                lastPlotPos = pos
                return
            end

            currentPlot = newPlot
            lastPlotPos = newPlot and pos or nil

            for plot, list in pairs(labelsByPlot) do
                local show = (plot == currentPlot)
                for _, bg in ipairs(list) do
                    if bg and bg.Parent then bg.Enabled = show end
                end
            end
        end

        -- OPTIMIZATION: timer for updating visible slots
        local slotUpdateAcc = 0

        -- Heartbeat: only platform check + visibility (less frequent)
        conns[#conns + 1] = RunService.Heartbeat:Connect(function(dt)
            -- Platform check every 100ms
            platformAcc = platformAcc + dt
            if platformAcc >= 0.1 then
                checkPlatformOptimized(platformAcc)
                platformAcc = 0
            end

            -- Visibility update every 500ms
            visAcc = visAcc + dt
            if visAcc >= 0.5 then
                updateVisibilityOptimized()
                visAcc = 0
            end

            -- OPTIMIZATION: visible slots update every 300ms
            slotUpdateAcc = slotUpdateAcc + dt
            if slotUpdateAcc >= 0.3 then
                updateVisibleSlots()
                slotUpdateAcc = 0
            end
        end)

        -- RenderStepped: animation + label scale in one connection
        conns[#conns + 1] = RunService.RenderStepped:Connect(function(dt)
            -- transparency animation at ~12 FPS
            animAcc = animAcc + dt
            if animAcc >= 0.08 then
                local time = os.clock() * 1.5
                if currentPlot and labelsByPlot[currentPlot] then
                    for _, item in ipairs(fills) do
                        if item.a and item.a.Parent then
                            local wave = (math.sin(time - (item.index * 0.12)) + 1) * 0.5
                            item.a.Transparency = math.clamp(item.base + (wave * 0.22 - 0.11), 0.15, 0.92)
                        end
                    end
                end
                animAcc = 0
            end

            -- label hover scale (only current plot)
            if not currentPlot then return end
            local list = labelsByPlot[currentPlot]
            if not list then return end
            local mousePos = UserInputService:GetMouseLocation()
            for _, bg in ipairs(list) do
                if bg.Enabled and bg.Adornee then
                    local btn = bg:FindFirstChildOfClass("TextButton")
                    if btn then
                        local uiScale = btn:FindFirstChildOfClass("UIScale")
                        if uiScale then
                            local pos3D = bg.Adornee.Position + bg.StudsOffset
                            local vector, onScreen = Camera:WorldToViewportPoint(pos3D)
                            local targetScale = 1.0
                            if onScreen and (Vector2.new(vector.X, vector.Y) - mousePos).Magnitude < 45 then
                                targetScale = 1.25
                            end
                            uiScale.Scale = uiScale.Scale + (targetScale - uiScale.Scale) * math.clamp(dt * 15, 0, 1)
                        end
                    end
                end
            end
        end)
    end

    updateVisibility()

    _G.__PodiumESPCleanup = function()
        alive = false
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        table.clear(conns)
        clear()
        _G.__PodiumESPCleanup = nil
    end
end

