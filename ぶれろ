-- Keep exactly one tool selected: if the current selection is not in
-- the inventory (first run, or the tool is gone) fall back to any fly
-- tool the player owns. A manual click overrides this and is saved to
-- the config by the auto-save loop.
local function ensureFlySelection(found)
    if #found == 0 then return end
    local valid = false
    for _, name in ipairs(found) do
        if name == flyConfig.SelectedItem then valid = true break end
    end
    if not valid then
        flyConfig.SelectedItem = found[1]
        pcall(updateFlightLogic)
    end
    applyFlySelectionVisual()
end

