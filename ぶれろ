local flyConfig = {
    Enabled = false,
    SelectedItem = "Flying Carpet",
    Speed = 180,
    AutoPilot = false,
    TargetPos = nil
}
local flyMoveConnection = nil
local flyToolsPanel = nil

local flyAbbreviations = {
    ["Flying Carpet"] = "Fl",
    ["Cupid's Wings"] = "Cu",
    ["Santa's Sleigh"] = "Sa",
