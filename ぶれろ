local function serverHopLowPlayers()
    local HttpService = game:GetService("HttpService")
    local apiUrl = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId)
    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(apiUrl))
    end)
    if not success or not response or not response.data then
        warn("[Srv Hop] Failed to get server list.")
        return
    end
    for _, server in ipairs(response.data) do
        if server.id ~= game.JobId and server.playing < server.maxPlayers and server.playing > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, player)
            return
        end
    end
    warn("[Srv Hop] No low-pop server found.")
end

