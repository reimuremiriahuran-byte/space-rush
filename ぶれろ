            tpFlying = true
            tpLbl.Text = "Resetting..."
            tpLbl.TextColor3 = Color3.fromRGB(255, 200, 100)

            -- Insta Reset first
            FableInstaReset()

            -- 100% respawn tracking: wait until character fully spawns
            tpLbl.Text = "Waiting spawn..."
            tpLbl.TextColor3 = Color3.fromRGB(255, 200, 100)

            local spawnTimeout = 15 -- max 15 seconds waiting for spawn
            local spawnStart = tick()
            local charReady = false

            while (tick() - spawnStart) < spawnTimeout do
                task.wait(0.1)
                local char = game.Players.LocalPlayer.Character
                if not char then continue end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    -- Character fully spawned and alive
                    charReady = true
                    break
                end
            end

            if not charReady then
                tpLbl.Text = "Spawn timeout"
                tpLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
                task.wait(1.5)
                tpLbl.Text = "Tp next Base"
                tpLbl.TextColor3 = COL_TEXT
                tpFlying = false
                return
            end

            task.wait(0.8) -- 0.80 sec delay after spawn for stabilization

            -- Check for fly gear before flight
            local char = game.Players.LocalPlayer.Character
            if not char then
                tpLbl.Text = "No character"
                tpLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
                task.wait(1.5)
                tpLbl.Text = "Tp next Base"
                tpLbl.TextColor3 = COL_TEXT
                tpFlying = false
                return
            end

            local hasFlyGear = char:FindFirstChild(flyConfig.SelectedItem)
            if not hasFlyGear then
                local backpack = game.Players.LocalPlayer.Backpack
                hasFlyGear = backpack and backpack:FindFirstChild(flyConfig.SelectedItem)
            end

            if not hasFlyGear then
                tpLbl.Text = "No fly gear: " .. flyConfig.SelectedItem
                tpLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
                task.wait(2)
                tpLbl.Text = "Tp next Base"
                tpLbl.TextColor3 = COL_TEXT
                tpFlying = false
                return
            end

            -- Find target
            local targetPos, err = findNextBaseMultiplier()
            if not targetPos then
                tpLbl.Text = err or "Error"
                tpLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
                task.wait(1.5)
                tpLbl.Text = "Tp next Base"
                tpLbl.TextColor3 = COL_TEXT
                tpFlying = false
                return
            end

            -- Enable fly autopilot
            tpLbl.Text = "Flying..."
            tpLbl.TextColor3 = Color3.fromRGB(100, 255, 150)

            flyConfig.Speed = 140
            flyConfig.TargetPos = targetPos
            flyConfig.AutoPilot = true
            flyConfig.Enabled = true
            updateFlightLogic() -- IMPORTANT: start flight loop after enabling

            -- Wait for arrival
            local char = game.Players.LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local startTime = tick()
            local timeout = 30

            while flyConfig.AutoPilot and char and hrp and (tick() - startTime) < timeout do
                local dist = (targetPos - hrp.Position).Magnitude
                if dist < 5 then
                    flyConfig.AutoPilot = false
                    break
                end
                task.wait(0.1)
            end

            -- Disable fly
            flyConfig.Enabled = false
            flyConfig.AutoPilot = false
            flyConfig.TargetPos = nil
            updateFlightLogic() -- Stop flight loop

            tpLbl.Text = "Tp next Base"
            tpLbl.TextColor3 = COL_TEXT
            tpFlying = false
        end)
    end
end)

