        box(root, cf * CFrame.new(0, y, -hz), Vector3.new(size.X, t, t), color, 0)
        box(root, cf * CFrame.new( hx, y, 0), Vector3.new(t, t, size.Z), color, 0)
        box(root, cf * CFrame.new(-hx, y, 0), Vector3.new(t, t, size.Z), color, 0)
