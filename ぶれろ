-- HIDE/UNHIDE PANELS TOOL
-- ==========================================
do
    pcall(function()
        local prev = player.Backpack:FindFirstChild("hide/unhide")
        if prev then prev:Destroy() end
        if player.Character then
            local prev2 = player.Character:FindFirstChild("hide/unhide")
            if prev2 then prev2:Destroy() end
        end
    end)

    local PANELS_TO_TOGGLE = { "Gear # Safety", "NearestPanel" }
    local savedVis = {}
    local panelsHidden = false

    local function makeHideTool(bp)
        local t = Instance.new("Tool")
        t.Name = "hide/unhide"
        t.RequiresHandle = false
        t.ToolTip = "Hide / Show panels"
        t.Parent = bp

        t.Activated:Connect(function()
            if not panelsHidden then
                for _, name in ipairs(PANELS_TO_TOGGLE) do
                    local entry = ConfigGuiPanels[name]
                    if entry then
                        savedVis[name] = entry.panel.Visible
                        entry.panel.Visible = false
                        entry.shadow.Visible = false
                    end
                end
                panelsHidden = true
            else
                for _, name in ipairs(PANELS_TO_TOGGLE) do
                    local entry = ConfigGuiPanels[name]
                    if entry then
                        local v = savedVis[name] == true
                        entry.panel.Visible = v
                        entry.shadow.Visible = v
                    end
                end
                panelsHidden = false
            end
        end)

        return t
    end

    local currentTool = makeHideTool(player.Backpack)



    player.CharacterAdded:Connect(function()
        task.wait(0.6)
        local bp = player:FindFirstChild("Backpack")
        if bp and not bp:FindFirstChild("hide/unhide") then
            currentTool = makeHideTool(bp)
        end
    end)
end

