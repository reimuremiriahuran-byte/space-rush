-- Resize grip (ported from the Heresy "makeResizable" idea, restyled):
-- a small 3D badge with a triangle sits in the bottom right corner of
-- every panel; dragging it resizes the panel (and its shadow) in both
-- axes, never below minW/minH. While dragging the badge lights up in
-- the accent gradient like the ON toggle badges.
local function makeResizable(panel, shadow, minW, minH)
    minW = minW or 220
    minH = minH or 54
    panel.ClipsDescendants = true

    local grip = Instance.new("TextButton")
    grip.Name = "ResizeGrip"
    grip.Size = UDim2.new(0, 12, 0, 12)
    grip.Position = UDim2.new(1, -14, 1, -14)
    grip.BackgroundColor3 = COL_ROW
    grip.BorderSizePixel = 0
    grip.AutoButtonColor = false
    grip.Text = "◢"
    grip.TextColor3 = COL_TRACK_ON
    grip.TextSize = 9
    grip.Font = Enum.Font.GothamMedium
    grip.ZIndex = 10
    grip.Parent = panel
    corner(grip, 6)
    make3D(grip, COL_ROW_TOP, COL_ROW_BOT)

    local gripGrad = Instance.new("UIGradient")
    gripGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, COL_ROW),
        ColorSequenceKeypoint.new(1, COL_ROW),
    }
    gripGrad.Parent = grip

    local function setGripActive(on)
        if on then
            grip.BackgroundColor3 = COL_TRACK_ON
            gripGrad.Color = ColorSequence.new(ACCENT_KEYS)
            grip.TextColor3 = Color3.fromRGB(30, 21, 22)
        else
            grip.BackgroundColor3 = COL_ROW
            gripGrad.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, COL_ROW),
                ColorSequenceKeypoint.new(1, COL_ROW),
            }
            grip.TextColor3 = COL_TRACK_ON
        end
    end

    local dragging, dragStart, startSize = false, nil, nil

    grip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startSize = Vector2.new(panel.Size.X.Offset, panel.Size.Y.Offset)
            setGripActive(true)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                setGripActive(false)
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = (input.Position - dragStart) / GUI_SCALE
            local nx = math.max(minW, math.floor(startSize.X + delta.X + 0.5))
            local ny = math.max(minH, math.floor(startSize.Y + delta.Y + 0.5))
            panel.Size = UDim2.new(0, nx, 0, ny)
            if shadow then
                shadow.Size = UDim2.new(0, nx + SHADOW_PAD * 2, 0, ny + SHADOW_PAD * 2)
            end
        end
    end)

    PanelResizeRegistry[panel.Name] = { panel = panel, shadow = shadow, minW = minW, minH = minH }
    return grip
end

-- Panel factory
local function createPanel(titleText, panelH, offsetX, contentBuilder)
    -- Shadow
    local shadow = Instance.new("ImageLabel")
    shadow.Name = "Shadow"
    shadow.BackgroundTransparency = 1
    shadow.Image = "rbxassetid://5554236805"
    shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    shadow.ImageTransparency = 0.4
    shadow.ScaleType = Enum.ScaleType.Slice
    shadow.SliceCenter = Rect.new(23, 23, 277, 277)
    shadow.Size = UDim2.new(0, PANEL_W + SHADOW_PAD * 2, 0, panelH + SHADOW_PAD * 2)
    shadow.Position = UDim2.new(1, -PANEL_W - offsetX - SHADOW_PAD, 0.5, -panelH/2 - SHADOW_PAD + 10)
    shadow.Parent = screenGui

    -- Panel
    local panel = Instance.new("Frame")
    panel.Size = UDim2.new(0, PANEL_W, 0, panelH)
    panel.Position = UDim2.new(1, -PANEL_W - offsetX, 0.5, -panelH/2 + 10)
    panel.BackgroundColor3 = COL_BG
    panel.BorderSizePixel = 0
    panel.Visible = true
    panel.Active = true
    panel.Parent = screenGui
    corner(panel, 12)
    do
        local ps = Instance.new("UIStroke")
        ps.Color = Color3.fromRGB(214, 206, 205)
        ps.Thickness = 1
        ps.Transparency = 0.72
        ps.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        ps.Parent = panel
    end

    -- Gradient
    local panelGrad = Instance.new("UIGradient")
    panelGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(39, 30, 31)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 21, 22)),
    }
    panelGrad.Rotation = 180
    panelGrad.Parent = panel

    -- Title
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -12, 0, isMobile and 16 or 32)
    title.Position = UDim2.new(0, 10, 0, isMobile and 3 or 6)
    title.BackgroundTransparency = 1
    title.Text = titleText
    title.TextSize = 18
    title.Font = Enum.Font.GothamMedium
    title.TextColor3 = COL_TEXT
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = panel

    local titleGrad = Instance.new("UIGradient")
    titleGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(207, 200, 200)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(185, 178, 178)),
    }
    titleGrad.Rotation = 0
    titleGrad.Parent = title

    -- Divider
    local divider = Instance.new("Frame")
    divider.Size = UDim2.new(1, -20, 0, 1)
    divider.Position = UDim2.new(0, 10, 0, 36)
    divider.BackgroundColor3 = COL_DIVIDER
    divider.BorderSizePixel = 0
    divider.Parent = panel

    -- Content
    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, 0, 1, -44)
    content.Position = UDim2.new(0, 0, 0, 44)
    content.BackgroundTransparency = 1
    content.Parent = panel

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 6)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.Parent = content

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 6)
    padding.Parent = content

    -- Draggable
    do
        local dragging = false
        local dragInput, dragStart, startPos

        title.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragInput = input
                dragStart = input.Position
                startPos = panel.Position

                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        title.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = (input.Position - dragStart) / GUI_SCALE
                local newPanelPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                panel.Position = newPanelPos
                shadow.Position = UDim2.new(newPanelPos.X.Scale, newPanelPos.X.Offset - SHADOW_PAD, newPanelPos.Y.Scale, newPanelPos.Y.Offset - SHADOW_PAD)
            end
        end)
    end

    -- Build content
    if contentBuilder then contentBuilder(content) end

    panel.Name = titleText
    ConfigGuiPanels[titleText] = { panel = panel, shadow = shadow }
    makeResizable(panel, shadow, 220, 54)

    return panel
end

-- Toggle row factory with ON/OFF badge
-- Global tables for storing keybinds
local keybinds = {}
local ActionBindRegistry = {} -- registry for action buttons (Drop, Reset, Rejoin, etc)

local function makePanelToggle(parent, labelText, defaultState, onToggleFn, defaultKeybind)
    local state = defaultState or false
    local currentKeybind = defaultKeybind or nil
    local waitingForKey = false
    local lastClickTime = 0

    -- Declare functions in advance so they can be used in handlers
    local update
    local updateKeybindDisplay
    local setKeybind
    local clearKeybind

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -20, 0, 32)
    row.BackgroundColor3 = COL_ROW
    row.BorderSizePixel = 0
    row.Parent = parent
    corner(row, 9)

    -- 3D effect
    make3D(row, COL_ROW_TOP, COL_ROW_BOT)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -90, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = COL_TEXT
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Active = false
    lbl.Parent = row

    -- Keybind label (small keybind letter left of ON/OFF)
    local keybindLbl = Instance.new("TextButton")
    keybindLbl.Size = UDim2.new(0, 22, 0, 22)
    keybindLbl.Position = UDim2.new(1, -80, 0.5, -11)
    keybindLbl.BackgroundColor3 = COL_ROW
    keybindLbl.BorderSizePixel = 0
    keybindLbl.Text = currentKeybind or ""
    keybindLbl.TextColor3 = COL_TEXT_DIM
    keybindLbl.TextSize = 10
    keybindLbl.Font = Enum.Font.GothamMedium
    keybindLbl.AutoButtonColor = false
    keybindLbl.ZIndex = 6
    keybindLbl.Parent = row
    corner(keybindLbl, 5)

    -- ON/OFF badge
    local badge = Instance.new("Frame")
    badge.Size = UDim2.new(0, 44, 0, 22)
    badge.Position = UDim2.new(1, -52, 0.5, -11)
    badge.BackgroundColor3 = state and COL_TRACK_ON or COL_TRACK_OFF
    badge.BorderSizePixel = 0
    badge.Active = false
    badge.Parent = row
    corner(badge, 13)
    make3D(badge, Color3.fromRGB(43, 34, 35), Color3.fromRGB(28, 20, 21))

    local badgeGrad = Instance.new("UIGradient")
    badgeGrad.Name = "Volume"
    badgeGrad.Rotation = 90
    badgeGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(118, 118, 118)),
    }
    badgeGrad.Parent = badge

    local badgeStroke = Instance.new("UIStroke")
    badgeStroke.Color = Color3.fromRGB(255, 255, 255)
    badgeStroke.Thickness = 1
    badgeStroke.Transparency = 0.4
    badgeStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    badgeStroke.Parent = badge
    local bsGrad = Instance.new("UIGradient")
    bsGrad.Rotation = 90
    bsGrad.Transparency = NumberSequence.new{
        NumberSequenceKeypoint.new(0, 0.0),
        NumberSequenceKeypoint.new(0.45, 1.0),
        NumberSequenceKeypoint.new(1, 1.0),
    }
    bsGrad.Parent = badgeStroke

    local badgeLbl = Instance.new("TextLabel")
    badgeLbl.Size = UDim2.new(1, 0, 1, 0)
    badgeLbl.BackgroundTransparency = 1
    badgeLbl.Text = state and "ON" or "OFF"
    badgeLbl.TextColor3 = state and Color3.fromRGB(30, 21, 22) or COL_TEXT_DIM
    badgeLbl.TextSize = 10
    badgeLbl.Font = Enum.Font.GothamMedium
    badgeLbl.Active = false
    badgeLbl.Parent = badge

    -- Define functions BEFORE creating the button so they are not nil
    updateKeybindDisplay = function()
        if waitingForKey then
            keybindLbl.Text = "( )"
            keybindLbl.TextColor3 = COL_TEXT
        elseif currentKeybind then
            keybindLbl.Text = currentKeybind
            keybindLbl.TextColor3 = COL_TEXT_DIM
        else
            keybindLbl.Text = ""
        end
    end

    setKeybind = function(key)
        currentKeybind = key
        keybinds[labelText] = key
        updateKeybindDisplay()
    end

    clearKeybind = function()
        currentKeybind = nil
        keybinds[labelText] = nil
        updateKeybindDisplay()
    end

    update = function(on, skipCallback)
        state = on
        TweenService:Create(badge, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
            BackgroundColor3 = on and COL_TRACK_ON or COL_TRACK_OFF,
        }):Play()
        badgeLbl.TextColor3 = on and Color3.fromRGB(30, 21, 22) or COL_TEXT_DIM
        badgeLbl.Text = on and "ON" or "OFF"
        if not skipCallback and onToggleFn then onToggleFn(on) end
    end

    -- Main toggle button (created AFTER defining functions)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 7
    btn.Parent = row
    btn.MouseButton1Click:Connect(function()
        update(not state)
    end)

    -- Handle clicks on keybind label
    keybindLbl.MouseButton1Click:Connect(function()
        local now = os.clock()
        if now - lastClickTime < 0.3 then
            -- Double left click - reset bind
            clearKeybind()
            waitingForKey = false
            updateKeybindDisplay()
            lastClickTime = 0
        else
            -- Single click - start waiting for key
            waitingForKey = true
            updateKeybindDisplay()
            lastClickTime = now
        end
    end)

    keybindLbl.MouseButton2Click:Connect(function()
        local now = os.clock()
        if now - lastClickTime < 0.3 then
            -- Double right click - reset bind
            clearKeybind()
            waitingForKey = false
            updateKeybindDisplay()
            lastClickTime = 0
        else
            -- Single right click - start waiting for key
            waitingForKey = true
            updateKeybindDisplay()
            lastClickTime = now
        end
    end)

    PanelToggleRegistry[labelText] = {
        get = function() return state end,
        set = function(on)
            if (on == true) ~= state then
                update(on == true)
            end
        end,
        getKeybind = function() return currentKeybind end,
        setKeybind = setKeybind,
        isWaiting = function() return waitingForKey end,
        waitForKey = function(key)
            if waitingForKey then
                setKeybind(key)
                waitingForKey = false
                updateKeybindDisplay()
                return true
            end
            return false
        end,
    }

    -- Save initial keybind
    if defaultKeybind then
        keybinds[labelText] = defaultKeybind
    end

    return update
end

