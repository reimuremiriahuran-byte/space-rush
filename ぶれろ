    local function checkPlatformStep(dt)
        local char = LP.Character
        if not char then
            wasOnPlatform = false
            standTimer = 0
            return
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then
            wasOnPlatform = false
            standTimer = 0
            return
        end

        local state = hum:GetState()
        local isFreefall = (state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.FallingDown)

        local vel = hrp.AssemblyLinearVelocity
        local isFastVertical = math.abs(vel.Y) > 6

        local pos = hrp.Position
        local isOnTop = false

        for _, anchor in ipairs(labelAnchors) do
            if anchor and anchor.Parent then
                local rel = anchor.CFrame:PointToObjectSpace(pos)
                if math.abs(rel.X) <= 3.0 and math.abs(rel.Z) <= 3.0 and rel.Y >= 0.1 and rel.Y <= 3.0 then
                    isOnTop = true
                    break
                end
            end
        end

        if isOnTop and not isFreefall and not isFastVertical then
            standTimer = standTimer + dt
            if standTimer >= STAND_THRESHOLD then
                if not wasOnPlatform then
                    wasOnPlatform = true
                    equipBat()
                end
            end
        else
            standTimer = 0
            wasOnPlatform = false
        end
    end

