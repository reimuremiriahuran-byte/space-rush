-- ══════════════════════════════════════════════
-- ANTI-WAVE DRAIN — удаляем порциями по кадрам.
-- Резкое удаление тысяч объектов за один кадр даёт
-- подозрительный всплеск активности (античиты палят
-- именно по скорости удаления). Размазываем работу
-- по кадрам с лимитом на кадр + неровным темпом.
-- ══════════════════════════════════════════════

-- Сколько Destroy() выполняем за кадр. Держим низко, чтобы
-- пик удалений в кадре не выделялся на фоне обычной игры.
local KILL_PER_FRAME = 45
local killDraining = false

-- Запускаем один фоновый дренажер очереди. Он сам уступает
-- кадр каждые KILL_PER_FRAME удалений и гаснет, когда очередь пуста.
local function ensureKillDrain()
    if killDraining then return end
    killDraining = true
    task.spawn(function()
        local _wait  = task.wait
        local _rnd   = math.random
        local _pcall = pcall
        local _tmove = table.move
        local _min   = math.min
        while true do
            local q = _G.__SXE_KillQ
            if #q == 0 then
                killDraining = false
                return
            end

            local probe = _min(KILL_PER_FRAME, #q)
            local heavy = false
            for i = 1, probe do
                local x = q[i]
                if x and x.Parent and #x:GetChildren() > 40 then heavy = true break end
            end
            local limit = _min(heavy and 10 or KILL_PER_FRAME, #q)

            for i = 1, limit do
                local x = q[i]
                if x and x.Parent then
                    _pcall(function() x:Destroy() end)
                end
            end
            _tmove(q, limit + 1, #q, 1)
            for i = #q - limit + 1, #q do q[i] = nil end

            _wait(heavy and (_rnd() * 0.04 + 0.012) or 0)
        end
    end)
end

-- Поставить объект в постепенную очередь (вместо мгновенного Destroy).
function _G.SXE_KillQueued(inst)
    if not inst or not inst.Parent then return end
    local q = _G.__SXE_KillQ
    q[#q + 1] = inst
    ensureKillDrain()
end

-- Немедленно вытеснить очередь, но БЕЗ шквала Destroy в одном кадре:
-- уступаем кадр каждые 45 удалений, поэтому всплеска всё равно нет.
function _G.SXE_FlushKills()
    local q = _G.__SXE_KillQ
    _G.__SXE_KillQ = {}
    for i = 1, #q do
        local x = q[i]
        if x and x.Parent then
            pcall(function() x:Destroy() end)
        end
        if i % 45 == 0 then task.wait() end
    end
end

