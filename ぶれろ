local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = parent
    return c
end

-- 3D button effect: top highlight + bottom shadow
local function make3D(parent, topColor, botColor)
    -- Top highlight line
    local top = Instance.new("Frame")
    top.Size = UDim2.new(1, 0, 0, 1)
    top.Position = UDim2.new(0, 0, 0, 0)
    top.BackgroundColor3 = topColor or COL_ROW_TOP
    top.BorderSizePixel = 0
    top.Active = false
    top.Parent = parent

    -- Bottom shadow line
    local bot = Instance.new("Frame")
    bot.Size = UDim2.new(1, 0, 0, 1)
    bot.Position = UDim2.new(0, 0, 1, -1)
    bot.BackgroundColor3 = botColor or COL_ROW_BOT
    bot.BorderSizePixel = 0
    bot.Active = false
    bot.Parent = parent
end

-- Volume shading: brightens the top edge and darkens the bottom,
-- applied through Transparency so it stacks under the ON/OFF gradient.
local function makeVolume(parent, strength)
    local grad = Instance.new("UIGradient")
    grad.Name = "Volume"
    grad.Rotation = 90
    local topA = 0.55
    local botA = strength or 0.10
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0)),
    })
    grad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, topA),
        NumberSequenceKeypoint.new(1, botA),
    })
    grad.Parent = parent
    return grad
end

