local function killInvisibleWalls()
    local _rnd   = math.random
    local _delay = task.delay
    local _wait  = task.wait
    local _pcall = pcall
    local _kq    = _G.SXE_KillQueued
    local function _safeKill(inst)
        local kq = _kq or _G.SXE_KillQueued
        if kq then
            kq(inst)
        else
            _pcall(function() inst:Destroy() end)
        end
    end
    local function removeWallParts(iw)
        if not iw then return end
        local descs    = iw:GetDescendants()
        local yieldAt  = _rnd(27, 45)
        local yieldCnt = 0
        for i, desc in ipairs(descs) do
            _pcall(function()
                if desc:IsA("SurfaceAppearance") or desc:IsA("Decal") or desc:IsA("Texture") then
                    desc:Destroy()
                elseif desc:IsA("SpecialMesh") then
                    desc.TextureId = ""
                elseif desc:IsA("BasePart") or desc:IsA("MeshPart") then
                    desc.Transparency = 1
                    desc.CanCollide   = false
                    desc.CastShadow   = false
                    desc.Material     = Enum.Material.SmoothPlastic
                    desc.Reflectance  = 0
                    local jitter = _rnd() * 2.8 + 0.6 + _rnd() * 1.1
                    _delay(jitter, function()
                        _safeKill(desc)
                    end)
                end
            end)
            yieldCnt = yieldCnt + 1
            if yieldCnt >= yieldAt then
                yieldCnt = 0
                yieldAt  = _rnd(27, 45)
                _wait(_rnd() * 0.05 + 0.008)
            end
        end
        iw.DescendantAdded:Connect(function(desc)
            _delay(_rnd() * 0.18 + 0.04, function()
                _pcall(function()
                    if desc:IsA("SurfaceAppearance") or desc:IsA("Decal") or desc:IsA("Texture") then
                        desc:Destroy()
                    elseif desc:IsA("SpecialMesh") then
                        desc.TextureId = ""
                    elseif desc:IsA("BasePart") or desc:IsA("MeshPart") then
                        desc.Transparency = 1
                        desc.CanCollide   = false
                        desc.CastShadow   = false
                        desc.Material     = Enum.Material.SmoothPlastic
                        desc.Reflectance  = 0
                        _delay(_rnd() * 2.0 + 0.5, function()
                            _safeKill(desc)
                        end)
                    end
                end)
            end)
        end)
    end
    local function scanPlot(plot)
        local iw = plot:FindFirstChild("InvisibleWalls")
        if iw then task.spawn(function() removeWallParts(iw) end) end
        plot.ChildAdded:Connect(function(child)
            if child.Name == "InvisibleWalls" then
                task.spawn(function() removeWallParts(child) end)
            end
        end)
    end
    local function bindContainer(container)
        for _, plot in ipairs(container:GetChildren()) do scanPlot(plot) end
        container.ChildAdded:Connect(function(plot) scanPlot(plot) end)
    end
    if plotsContainer then bindContainer(plotsContainer)
    else Workspace.ChildAdded:Connect(function(c)
        if c.Name == "Plots" then bindContainer(c) end
    end) end
end

local function cleanBasewalls()
    local function hideAllDescendants(obj)
