-- ==========================================
-- CONFIG (BaseGuardian.json)
-- Toggle states, selected fly tool and GUI panel
-- positions are saved automatically and restored
-- on the next execution.
-- ==========================================
do
    local CONFIG_PATH = "BaseGuardian.json"
    local HttpService = game:GetService("HttpService")

    local function collectConfig()
        local toggles = {}
        for label, entry in pairs(PanelToggleRegistry) do
            local ok, st = pcall(entry.get)
            if ok then toggles[label] = (st == true) end
        end
        local positions = {}
        for name, entry in pairs(ConfigGuiPanels) do
            local p = entry.panel.Position
            positions[name] = { xs = p.X.Scale, xo = p.X.Offset, ys = p.Y.Scale, yo = p.Y.Offset }
        end
        local sizes = {}
        for name, entry in pairs(PanelResizeRegistry) do
            local s = entry.panel.Size
            sizes[name] = { x = s.X.Offset, y = s.Y.Offset }
        end
        -- Сохраняем бинды
        local binds = {}
        for label, key in pairs(keybinds) do
            binds[label] = key
        end
        return { toggles = toggles, positions = positions, sizes = sizes, binds = binds, flyTool = flyConfig.SelectedItem, serverHidden = isServerHidden, fpsMode = fpsBoostMode }
    end

    -- stable serializer (sorted keys), used only for change detection
    local function encodeValue(v)
        local t = type(v)
        if t == "boolean" then
            return v and "true" or "false"
        elseif t == "number" then
            return string.format("%.17g", v)
        elseif t == "string" then
            return string.format("%q", v)
        elseif t == "table" then
            local keys = {}
            for k in pairs(v) do keys[#keys + 1] = tostring(k) end
            table.sort(keys)
            local parts = {}
            for _, k in ipairs(keys) do
                parts[#parts + 1] = string.format("%q", k) .. "=" .. encodeValue(v[k])
            end
            return "{" .. table.concat(parts, ",") .. "}"
        end
        return "nil"
    end

    local function loadConfigData()
        if type(readfile) ~= "function" then return nil end
        if type(isfile) == "function" then
            local ok, exists = pcall(isfile, CONFIG_PATH)
            if not (ok and exists == true) then return nil end
        end
        local ok, content = pcall(readfile, CONFIG_PATH)
        if not ok or type(content) ~= "string" or content == "" then return nil end
        local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
        if ok2 and type(data) == "table" then return data end
        return nil
    end

    local lastSavedJson = nil

    local function trySave()
        local ok, current = pcall(collectConfig)
        if not (ok and current) then return end
        local encoded = encodeValue(current)
        if encoded == lastSavedJson then return end
        lastSavedJson = encoded
        if type(writefile) == "function" then
            pcall(function()
                writefile(CONFIG_PATH, HttpService:JSONEncode(current))
            end)
        end
    end

    -- Restore saved state
    local saved = loadConfigData()
    if saved then
        -- panel positions first
        if type(saved.positions) == "table" then
            for name, pos in pairs(saved.positions) do
                local entry = ConfigGuiPanels[name]
                if entry and entry.panel and entry.panel.Parent and type(pos) == "table" then
                    local p = entry.panel.Position
                    local xs = tonumber(pos.xs) or p.X.Scale
                    local xo = tonumber(pos.xo) or p.X.Offset
                    local ys = tonumber(pos.ys) or p.Y.Scale
                    local yo = tonumber(pos.yo) or p.Y.Offset
                    entry.panel.Position = UDim2.new(xs, xo, ys, yo)
                    if entry.shadow then
                        entry.shadow.Position = UDim2.new(xs, xo - SHADOW_PAD, ys, yo - SHADOW_PAD)
                    end
                end
            end
        end
        -- panel sizes (resize grips)
        if type(saved.sizes) == "table" then
            for name, sz in pairs(saved.sizes) do
                local entry = PanelResizeRegistry[name]
                if entry and entry.panel and entry.panel.Parent and type(sz) == "table" then
                    local x = math.max(entry.minW, tonumber(sz.x) or entry.panel.Size.X.Offset)
                    local y = math.max(entry.minH, tonumber(sz.y) or entry.panel.Size.Y.Offset)
                    entry.panel.Size = UDim2.new(0, x, 0, y)
                    if entry.shadow then
                        entry.shadow.Size = UDim2.new(0, x + SHADOW_PAD * 2, 0, y + SHADOW_PAD * 2)
                    end
                end
            end
        end
        -- selected fly tool
        if type(saved.flyTool) == "string" and saved.flyTool ~= "" then
            local valid = false
            for _, toolName in ipairs(flyToolItems) do
                if toolName == saved.flyTool then valid = true break end
            end
            if valid and flyConfig.SelectedItem ~= saved.flyTool then
                flyConfig.SelectedItem = saved.flyTool
                for _, entry in ipairs(flyToolButtons) do
                    if entry.name == saved.flyTool then
                        entry.btn.BackgroundColor3 = Color3.fromRGB(214, 206, 205)
                        entry.lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                    else
                        entry.btn.BackgroundColor3 = COL_ROW
                        entry.lbl.TextColor3 = COL_TEXT
                    end
                end
                if flyBoxLabel then
                    flyBoxLabel.Text = flyAbbreviations[saved.flyTool] or saved.flyTool:sub(1, 2)
                end
                pcall(updateFlightLogic)
            end
        end
        -- server job id hide state
        if saved.serverHidden == true then
            isServerHidden = true
            pcall(function() jobIdLbl.Text = serverHiddenText end)
        end
        -- fps boost mode
        if type(saved.fpsMode) == "string" and (saved.fpsMode == "Def" or saved.fpsMode == "Ultra") then
            fpsBoostMode = saved.fpsMode
            -- обновляем UI если он уже создан
            if _G.__fpsModeLabel then
                _G.__fpsModeLabel.Text = saved.fpsMode
            end
        end
        -- toggle states (Nearest before Instant so the panel is up first)
        if type(saved.toggles) == "table" then
            local restoreOrder = { "Nearest", "Instant", "Insta Steal", "Podium ESP", "Next Base", "Flying Speed", "Infinite Jump", "Auto Kick", "Anti Die", "Fps Boost" }
            for _, label in ipairs(restoreOrder) do
                if saved.toggles[label] == true then
                    local entry = PanelToggleRegistry[label]
                    if entry then pcall(entry.set, true) end
                end
            end
            for label, value in pairs(saved.toggles) do
                if value == true then
                    local entry = PanelToggleRegistry[label]
                    if entry then
                        local ok, st = pcall(entry.get)
                        if not (ok and st == true) then pcall(entry.set, true) end
                    end
                end
            end
        end
        -- Восстанавливаем бинды
        if type(saved.binds) == "table" then
            for label, key in pairs(saved.binds) do
                if type(key) == "string" and key ~= "" then
                    -- Проверяем PanelToggleRegistry
                    local panelEntry = PanelToggleRegistry[label]
                    if panelEntry and panelEntry.setKeybind then
                        pcall(panelEntry.setKeybind, key)
                    end
                    -- Проверяем ActionBindRegistry
                    local actionEntry = ActionBindRegistry[label]
                    if actionEntry and actionEntry.setKeybind then
                        pcall(actionEntry.setKeybind, key)
                    end
                end
            end
        end
    end

    -- Auto-save: polls state and writes on any change; extra
    -- check on mouse release so drags are saved immediately
    task.spawn(function()
        while true do
            task.wait(1)
            trySave()
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            task.delay(0.2, trySave)
        end
    end)
end

