-- ==========================================
-- ANTI DIE LOGIC
-- ==========================================
local antiDieEnabled = false
local antiDieConns = {}
local antiDieCharConn = nil

local function antiDieHarden(hum)
    pcall(function() hum.BreakJointsOnDeath = false end)
    pcall(function() hum.RequiresNeck = false end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false) end)
end

local function antiDieRevive(hum)
    pcall(function() hum.Health = hum.MaxHealth end)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
end

local function antiDieBind()
    for _, conn in ipairs(antiDieConns) do
        pcall(function() conn:Disconnect() end)
    end
    antiDieConns = {}

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    antiDieHarden(hum)

    local healthConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
        if not antiDieEnabled then return end
        if hum.Health <= 0 then antiDieRevive(hum) end
    end)
    table.insert(antiDieConns, healthConn)

    local diedConn = hum.Died:Connect(function()
        if not antiDieEnabled then return end
        antiDieRevive(hum)
    end)
    table.insert(antiDieConns, diedConn)

    local lastHarden = 0
    local hbConn = RunService.Heartbeat:Connect(function()
        if not antiDieEnabled or not hum or not hum.Parent then return end
        local now = os.clock()
        if now - lastHarden >= 1 then
            lastHarden = now
            antiDieHarden(hum)
        end
        if hum.Health <= 0 then antiDieRevive(hum) end
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Dead
           or state == Enum.HumanoidStateType.Ragdoll
           or state == Enum.HumanoidStateType.FallingDown then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
        end
    end)
    table.insert(antiDieConns, hbConn)
end

local function startAntiDie()
    antiDieEnabled = true
    antiDieBind()

    if antiDieCharConn then
        pcall(function() antiDieCharConn:Disconnect() end)
        antiDieCharConn = nil
    end
    antiDieCharConn = player.CharacterAdded:Connect(function(char)
        if not antiDieEnabled then return end
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then antiDieHarden(hum) end
        task.wait(0.1)
        antiDieBind()
    end)
end

local function stopAntiDie()
    antiDieEnabled = false
    for _, conn in ipairs(antiDieConns) do
        pcall(function() conn:Disconnect() end)
    end
    antiDieConns = {}
    if antiDieCharConn then
        pcall(function() antiDieCharConn:Disconnect() end)
        antiDieCharConn = nil
    end
end

local function toggleAntiDie(on)
    if on then
        startAntiDie()
    else
        stopAntiDie()
    end
end

-- ==========================================
-- INFINITE JUMP LOGIC
-- ==========================================
local infJumpEnabled = false
local infJumpConns = {}

local INF_JUMP_FORCE = 50
local INF_FALL_CLAMP = 50
local INF_HOLD_CLIMB = 45

local function startInfJump()
    infJumpEnabled = true

    local fallConn = RunService.Heartbeat:Connect(function()
        if not infJumpEnabled then return end
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.Velocity.Y < -INF_FALL_CLAMP then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, -INF_FALL_CLAMP, hrp.Velocity.Z)
        end
    end)
    table.insert(infJumpConns, fallConn)

    local jumpConn = UserInputService.JumpRequest:Connect(function()
        if not infJumpEnabled then return end
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, INF_JUMP_FORCE, hrp.Velocity.Z)
        end
    end)
    table.insert(infJumpConns, jumpConn)

    local jumpHeld = false
    local holdBegin = UserInputService.InputBegan:Connect(function(inp, gpe)
        if gpe then return end
        if inp.KeyCode == Enum.KeyCode.Space then jumpHeld = true end
    end)
    table.insert(infJumpConns, holdBegin)

    local holdEnd = UserInputService.InputEnded:Connect(function(inp)
        if inp.KeyCode == Enum.KeyCode.Space then jumpHeld = false end
    end)
    table.insert(infJumpConns, holdEnd)

    local holdConn = RunService.Heartbeat:Connect(function()
        if not infJumpEnabled or not jumpHeld then return end
        if not UserInputService:IsKeyDown(Enum.KeyCode.Space) then jumpHeld = false return end
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.Velocity.Y < INF_HOLD_CLIMB then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, INF_HOLD_CLIMB, hrp.Velocity.Z)
        end
    end)
    table.insert(infJumpConns, holdConn)
end

local function stopInfJump()
    infJumpEnabled = false
    for _, c in ipairs(infJumpConns) do pcall(function() c:Disconnect() end) end
    infJumpConns = {}
end

-- ==========================================
-- AUTO KICK LOGIC
-- ==========================================
local autoKickEnabled = false
local autoKickConns = {}
local STEAL_KEYWORD = "you stole"

local function hasStealKeyword(text)
    if typeof(text) ~= "string" then return false end
    return string.find(string.lower(text), STEAL_KEYWORD, 1, true) ~= nil
end

local function extractStolenItem(fullText)
    if typeof(fullText) ~= "string" then return "Unknown" end
    local item = fullText:match("[Yy]ou stole%s*(.+)")
    if not item then return "Unknown" end
    item = item:gsub("<[^>]->", "")
    item = item:gsub("^%s+", ""):gsub("%s+$", "")
    return item
end

local function kickForSteal(fullText)
    local item = extractStolenItem(fullText)
    local message = "GG steal | You Stole " .. item
    pcall(function() player:Kick(message) end)
end

local function watchTextObject(obj)
    if not obj then return end
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then return end

    local function check()
        if not autoKickEnabled then return end
        local text = obj.Text
        if typeof(text) ~= "string" then return end
        if hasStealKeyword(text) then kickForSteal(text) end
    end

    pcall(check)
    local conn = obj:GetPropertyChangedSignal("Text"):Connect(function()
        pcall(check)
    end)
    table.insert(autoKickConns, conn)
end

local function startAutoKick()
    autoKickEnabled = true
    for _, conn in ipairs(autoKickConns) do pcall(function() conn:Disconnect() end) end
    autoKickConns = {}

    local playerGui = player:WaitForChild("PlayerGui")
    for _, obj in ipairs(playerGui:GetDescendants()) do
        watchTextObject(obj)
    end

    local conn = playerGui.DescendantAdded:Connect(function(desc)
        pcall(function() watchTextObject(desc) end)
    end)
    table.insert(autoKickConns, conn)
end

local function stopAutoKick()
    autoKickEnabled = false
    for _, conn in ipairs(autoKickConns) do pcall(function() conn:Disconnect() end) end
    autoKickConns = {}
end

