        local rs = game:GetService("ReplicatedStorage")
        local items = rs:FindFirstChild("Items")
        if items then
            local tool = items:FindFirstChild(itemName)
            if tool and tool:IsA("Tool") then
                icon = tool.TextureId or ""
            end
        end
    end)
    if icon == "" then
