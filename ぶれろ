-- ANTI RAGDOLL (always on)
-- ==========================================
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local arConns = {}
local arChar, arHum, arRoot, arAnim
local arLastVel = Vector3.new(0, 0, 0)
local AR_VEL_THRESH = 40
local AR_VEL_MAG_THRESH = 25
local AR_MAX_VEL = 15

local function arIsRagdolled()
    if not arHum then return false end
    local s = arHum:GetState()
    return s == Enum.HumanoidStateType.Physics
        or s == Enum.HumanoidStateType.Ragdoll
        or s == Enum.HumanoidStateType.FallingDown
        or s == Enum.HumanoidStateType.GettingUp
end

local function arIsFlying()
    if not arChar then return false end
    local hrp = arChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    for _, o in ipairs(hrp:GetChildren()) do
        if o:IsA("BodyVelocity") or o:IsA("BodyPosition") or o:IsA("BodyGyro") then return true end
    end
    return false
end

local function arEnableControls()
    pcall(function()
        local pm = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10)
        if pm then require(pm):GetControls():Enable() end
    end)
end

local function arCleanup()
    if not arChar then return end
    local flying = arIsFlying()
    local function process(parent)
        for _, o in ipairs(parent:GetChildren()) do
            if o:IsA("BallSocketConstraint") or o:IsA("NoCollisionConstraint") or o:IsA("HingeConstraint")
               or (o:IsA("Attachment") and (o.Name == "A" or o.Name == "B")) then
                o:Destroy()
            elseif o:IsA("BodyVelocity") or o:IsA("BodyPosition") or o:IsA("BodyGyro") then
                if not flying then o:Destroy() end
            elseif o:IsA("Motor6D") then
                o.Enabled = true
            elseif o:IsA("BasePart") then
                for _, c in ipairs(o:GetChildren()) do
                    if c:IsA("BallSocketConstraint") or c:IsA("NoCollisionConstraint") or c:IsA("HingeConstraint") then
                        c:Destroy()
                    elseif c:IsA("Motor6D") then
                        c.Enabled = true
                    elseif c:IsA("Attachment") and (c.Name == "A" or c.Name == "B") then
                        c:Destroy()
                    end
                end
            end
        end
    end
    pcall(function() process(arChar) end)
    if arAnim then
        for _, t in pairs(arAnim:GetPlayingAnimationTracks()) do
            local n = t.Animation and t.Animation.Name:lower() or ""
            if n:find("rag") or n:find("fall") or n:find("hurt") or n:find("down") then
                t:Stop(0)
            end
        end
    end
end

local function arSetupChar(char)
    arChar = char
    arHum = char:WaitForChild("Humanoid", 10)
    arRoot = char:WaitForChild("HumanoidRootPart", 10)
    arAnim = arHum and arHum:WaitForChild("Animator", 10)
    arLastVel = Vector3.new(0, 0, 0)
end

local function arClearConns()
    for _, c in ipairs(arConns) do pcall(function() c:Disconnect() end) end
    arConns = {}
end

local function arSetupConns()
    arClearConns()
    if not arHum or not arRoot then return end

    table.insert(arConns, arHum.StateChanged:Connect(function()
        if arIsRagdolled() and not arIsFlying() then
            arHum:ChangeState(Enum.HumanoidStateType.Running)
        end
        arCleanup()
        Workspace.CurrentCamera.CameraSubject = arHum
        arEnableControls()
    end))

    pcall(function()
        local pkg = ReplicatedStorage:FindFirstChild("Packages")
        if pkg then
            local net = pkg:FindFirstChild("Net")
            if net then
                local imp = net:FindFirstChild("RE/CombatService/ApplyImpulse")
                if imp then
                    table.insert(arConns, imp.OnClientEvent:Connect(function()
                        if arIsRagdolled() then
                            arRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end
                    end))
                end
            end
        end
    end)

    table.insert(arConns, arChar.DescendantAdded:Connect(function()
        if arIsRagdolled() then arCleanup() end
    end))

    table.insert(arConns, RunService.Heartbeat:Connect(function()
        if not arIsRagdolled() then return end
        arCleanup()
        local vel = arRoot.AssemblyLinearVelocity
        if (vel - arLastVel).Magnitude > AR_VEL_THRESH and vel.Magnitude > AR_VEL_MAG_THRESH then
            arRoot.AssemblyLinearVelocity = vel.Unit * math.min(vel.Magnitude, AR_MAX_VEL)
        end
        arLastVel = vel
    end))

    arEnableControls()
    arCleanup()
end

-- Start anti-ragdoll
